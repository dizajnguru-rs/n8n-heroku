{
  "name": "n8n",
  "description": "n8n za Dizajn Guru",
  "repository": "https://github.com/n8n-io/n8n-heroku",
  "success_url": "/",
  "stack": "container",
  "env": {
    "GENERIC_TIMEZONE": { "value": "Europe/Belgrade" },
    "TZ": { "value": "Europe/Belgrade" },
    "N8N_ENCRYPTION_KEY": {
      "description": "Generise se automatski. Odmah sacuvati u Bitwarden.",
      "generator": "secret"
    },
    "WEBHOOK_URL": {
      "description": "Posle deploya zameniti pravim URL-om iz Settings > Domains",
      "value": "https://zameniti-posle-deploya.herokuapp.com/"
    },
    "N8N_PROXY_HOPS": { "value": "1" },
    "DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED": { "value": "false" },
    "EXECUTIONS_DATA_PRUNE": { "value": "true" },
    "EXECUTIONS_DATA_MAX_AGE": { "value": "168" },
    "EXECUTIONS_DATA_PRUNE_MAX_COUNT": { "value": "5000" },
    "N8N_DIAGNOSTICS_ENABLED": { "value": "false" },
    "NODE_OPTIONS": { "value": "--max-old-space-size=400" }
  },
  "formation": {
    "web": { "quantity": 1, "size": "basic" }
  },
  "addons": [
    { "plan": "heroku-postgresql:essential-0" }
  ]
}
